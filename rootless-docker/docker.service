# Rootless Docker daemon using the distro-packaged dockerd, rootlesskit and slirp4netns.
# Equivalent to what dockerd-rootless.sh / dockerd-rootless-setuptool.sh would generate,
# without depending on the docker-rootless-extras package.
[Unit]
Description=Docker Application Container Engine (Rootless)
Documentation=https://docs.docker.com/go/rootless/

[Service]
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
# Inside the rootlesskit namespace, drop the copied-up symlinks for /run/docker,
# /run/containerd and /run/xtables.lock so dockerd can create its own (this is
# what the child half of dockerd-rootless.sh does), then exec dockerd.
ExecStart=/usr/bin/rootlesskit \
    --state-dir=%t/dockerd-rootlesskit \
    --net=slirp4netns --mtu=65520 \
    --slirp4netns-sandbox=auto --slirp4netns-seccomp=auto \
    --disable-host-loopback \
    --port-driver=builtin \
    --copy-up=/etc --copy-up=/run \
    --propagation=rslave \
    /bin/sh -c 'rm -f /run/docker /run/containerd /run/xtables.lock && exec /usr/bin/dockerd'
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
